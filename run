#!/bin/sh
# The one place Tidewaiter's build is defined, so CI runs the same commands a
# developer does. mise.toml's tasks (check, build, dist, release-due) call it;
# CI's gates call the rest:
# ./run <version|lint|test|check|selftest|e2e|build|dist|smoke|install-check|
#        release-due|last-release|release-json|nix-local-release|image>.
set -eu

cd "$(dirname "$0")"

NAME=tidewaiter

# The package the version is set in, at link time.
VERSION_VAR=github.com/danielbodart/tidewaiter/internal/version.Version

# Every architecture released, by its Docker platform's name without the
# slashes, which is what the Dockerfile asks dist/ for.
ARCHES="amd64 arm64 armv7"

# The plain units shipped beside the binary.
UNITS="systemd/tidewaiter.service"


die() {
  echo "Error: $*" >&2
  exit 1
}

# The version, derived from the repository rather than stored in it.
#
# Only the major is committed, in MAJOR, because only the major is a decision,
# and moving it is something a person does deliberately when compatibility
# breaks. The Go rewrite did not move it: the flags, labels, status file and
# state directory are the same, so a v1 install upgrades in place. It used to
# live in package.json, which went with Bun. The rest is a fact about the
# build, so recording it in the tree would only create a number that can
# disagree with what was published - a bump commit to forget, or a tag that
# says something the artifact does not.
#
# Minor is the commit count, so it only ever goes up and names exactly one
# commit. Patch is the CI run number, which separates two builds of the same
# commit - a re-run, or a manual dispatch - and locally becomes a timestamp
# instead, so a developer build sorts after CI's and is obviously not one.
version() {
  # Counted from HEAD, not from a branch name. On Actions the checkout is
  # detached, so `git rev-parse --abbrev-ref HEAD` answers "HEAD", and
  # GITHUB_REF_NAME on a pull request is "123/merge", which is not a rev at
  # all. HEAD is the commit being built in every one of those cases.
  if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    die "this is a shallow clone, so the commit count is wrong and so is the version. In Actions, checkout with \`fetch-depth: 0\`."
  fi
  echo "$(cat MAJOR).$(git rev-list --count HEAD).${GITHUB_RUN_NUMBER:-$(date -u +%Y%m%d%H%M%S)}"
}

lint() {
  unformatted=$(gofmt -l .)
  [ -z "$unformatted" ] || die "not gofmt'd: $unformatted"
  go vet ./...
}

test() {
  go test -count=1 "$@" ./...
}

check() {
  lint
  selftest
  test "$@"
}

# The Docker source against the Docker at DOCKER_HOST (or the default
# socket): recreates of real containers through Tidewaiter's own swap, read
# back and compared. It creates tw-e2e-* containers, networks and volumes and
# removes them, and pulls the two images it swaps between, never anything
# else.
e2e() {
  docker pull -q alpine:latest >/dev/null
  docker pull -q postgres:18 >/dev/null
  TIDEWAITER_DOCKER_TESTS=1 go test -count=1 -run Real -v "$@" ./internal/docker/
}

# Static, so the one binary runs on any distribution, glibc or musl, and in an
# empty image. The version reaches it as a link-time -X rather than a generated
# file, so nothing is written into the tree; without one it says
# "development", which is the truth about a `go run`.
#
# GOARM only means anything for arm, and is ignored otherwise; 7 is the Pi 2
# onwards on 32-bit Raspberry Pi OS, and the armhf most ARM NAS boxes run.
compile() {
  CGO_ENABLED=0 GOOS=linux GOARCH="$2" GOARM=7 \
    go build -trimpath -ldflags "-s -w -X $VERSION_VAR=$1" -o "$3" .
}

goarch() {
  case $1 in
    armv7) echo arm ;;
    *) echo "$1" ;;
  esac
}

# The name the Bun releases gave each architecture, which every
# releases/latest/download link points at: x64 is Go's amd64. armv7 is new with
# Go, which cross-compiles to it where Bun had no 32-bit ARM build at all.
asset_arch() {
  case $1 in
    amd64) echo x64 ;;
    *) echo "$1" ;;
  esac
}

# The tarballs' name for each architecture, the one every tool of
# danielbodart's uses for its tarballs (x86_64, aarch64, armv7). The tarballs
# came after the binaries, so no older link holds them to the binaries' names.
tarball_arch() {
  case $1 in
    amd64) echo x86_64 ;;
    arm64) echo aarch64 ;;
    *) echo "$1" ;;
  esac
}

build() {
  outfile=${1:-dist/$NAME}
  v=$(version)
  compile "$v" "$(go env GOARCH)" "$outfile"
  echo "built $outfile $v"
}

# Everything the upstream channel ships, from one compile per architecture:
#
#   dist/linux-<arch>/NAME     what the Dockerfile copies into each image
#   dist/release/              what a GitHub release carries: a binary per
#                              architecture, the unit(s), a tarball per
#                              architecture holding both with the README and
#                              LICENSE, and SHA256SUMS of them all
#   dist/version               the version all of it says, for CI's gates
dist() {
  v=$(version)
  rm -rf dist
  mkdir -p dist/release
  for arch in $ARCHES; do
    compile "$v" "$(goarch "$arch")" "dist/linux-$arch/$NAME"
    cp "dist/linux-$arch/$NAME" "dist/release/$NAME-linux-$(asset_arch "$arch")"
    tarball=$NAME-linux-$(tarball_arch "$arch")
    stage=dist/stage/$tarball/$NAME-$v
    mkdir -p "$stage"
    # shellcheck disable=SC2086 # $UNITS is a list of plain paths
    cp "dist/linux-$arch/$NAME" $UNITS README.md LICENSE "$stage/"
    tar -C "dist/stage/$tarball" --sort=name --owner=0 --group=0 --numeric-owner \
      -czf "dist/release/$tarball.tar.gz" "$NAME-$v"
  done
  rm -rf dist/stage
  # shellcheck disable=SC2086 # $UNITS is a list of plain paths
  cp $UNITS dist/release/
  (CDPATH='' cd dist/release && sha256sum -- * > SHA256SUMS)
  echo "$v" > dist/version
  echo "built dist $v"
}

# The image for this machine's architecture from dist/, run: it must say the
# version dist/ was built as.
smoke() {
  v=$(cat dist/version)
  docker buildx build --platform linux/amd64 --build-arg VERSION="$v" --load --tag "$NAME:smoke" .
  said=$(docker run --rm "$NAME:smoke" --version)
  [ "$said" = "$v" ] || die "the image says '$said' but dist is $v"
  echo "image says $said"
}

# The x86_64 tarball installed as its README says, the binary where the units
# expect it, and the units checked against a real systemd. Needs sudo.
install_check() {
  v=$(cat dist/version)
  root=$(mktemp -d)
  tar -C "$root" -xzf "dist/release/$NAME-linux-x86_64.tar.gz"
  dir=$root/$NAME-$v
  sudo install -m 755 "$dir/$NAME" "/usr/local/bin/$NAME"
  said=$("/usr/local/bin/$NAME" --version)
  [ "$said" = "$v" ] || die "the tarball's binary says '$said' but dist is $v"
  set --
  for file in "$dir"/*; do
    case $file in
      *.sysusers) sudo systemd-sysusers "$file" ;;
      *.service | *.socket) set -- "$@" "$file" ;;
    esac
  done
  # Together, so each unit finds the ones it names.
  systemd-analyze verify "$@"
  echo "installed and verified $NAME-$v"
}

# The last release before HEAD: prints its tag and the commit it released,
# "v<V> COMMIT", or nothing, failing, if there is none. release-due diffs from
# COMMIT, and CI's release notes list the commits since it.
#
# A release's tag is not on master. Since nix/release.json (flake.nix), it
# names a commit of its own, on no branch, whose parent is the released
# master commit and which adds only that file (ci.yml's release job says
# why), so `git describe`, which looks for tags among HEAD's ancestors, finds
# none. The released commit is the tag's parent; the tags made before that
# name the master commit itself, and count too. Of the tags whose released
# commit is HEAD or one of its ancestors, the newest by version is the last:
# the minor is the commit count, so it orders them along master.
last_release() {
  git tag --list 'v[0-9]*' --sort=-v:refname | {
    while read -r tag; do
      for c in "$tag^{commit}" "$tag^{commit}^"; do
        commit=$(git rev-parse -q --verify "$c" 2>/dev/null) || continue
        if git merge-base --is-ancestor "$commit" HEAD; then
          echo "$tag $commit"
          exit 0
        fi
      done
    done
    exit 1
  }
}

# Succeeds when a file in RELEASE_PATHS changed since the last release, or
# there is none yet. RELEASE_PATHS is mise.toml's, so this runs as
# `mise run release-due`. The diff is from the commit the last release was
# made from, not its tag's own commit, which adds nix/release.json: that is
# the release's output, not its input.
release_due() {
  : "${RELEASE_PATHS:?is set by mise.toml: run this as mise run release-due}"
  last=$(last_release) || {
    echo "no release yet" >&2
    return 0
  }
  tag=${last% *}
  commit=${last#* }
  # shellcheck disable=SC2086 # $RELEASE_PATHS is a list of plain paths
  changed=$(git diff --name-only "$commit" HEAD -- $RELEASE_PATHS)
  [ -n "$changed" ] || {
    echo "nothing released has changed since $tag" >&2
    return 1
  }
  echo "changed since $tag:" "$changed" >&2
}

# Each Nix system flake.nix packages, and the release binary that serves it:
# the plain binaries, under the names the first releases gave them.
NIX_ASSETS="x86_64-linux:tidewaiter-linux-x64 aarch64-linux:tidewaiter-linux-arm64 armv7l-linux:tidewaiter-linux-armv7"

# A hex SHA-256 in the SRI form fetchurl takes, sha256-<base64 of the 32
# bytes>, without nix, which the release job has none of.
sri() {
  printf 'sha256-%s' "$(printf '%s' "$1" | tr a-f A-F | basenc --base16 -d | base64 -w0)"
}

# nix/release.json for a release, on stdout: its version, and for each Nix
# system the URL of its binary and the binary's hash. flake.nix's package is
# that binary fetched, not a build from source, so a flake pinned at
# github:danielbodart/tidewaiter/v<V> runs the very binary the release carries,
# saying it is V. Every binary must be in SHA256SUMS exactly once.
#
#   ./run release-json [VERSION SHA256SUMS]   (default: dist/'s)
release_json() {
  v=${1:-$(cat dist/version)}
  sums=${2:-dist/release/SHA256SUMS}
  echo "$v" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' || die "release-json: '$v' is not MAJOR.MINOR.PATCH"
  printf '{\n  "version": "%s",\n  "assets": {\n' "$v"
  n=0
  total=$(echo "$NIX_ASSETS" | wc -w)
  for pair in $NIX_ASSETS; do
    system=${pair%%:*}
    asset=${pair#*:}
    hex=$(awk -v n="$asset" '$2 == n || $2 == "*" n { print $1 }' "$sums")
    echo "$hex" | grep -Eqx '[0-9a-f]{64}' || die "release-json: want one sha256 for $asset in $sums, found '$hex'"
    n=$((n + 1))
    sep=,
    [ "$n" -lt "$total" ] || sep=
    printf '    "%s": {\n      "url": "https://github.com/danielbodart/%s/releases/download/v%s/%s",\n      "hash": "%s"\n    }%s\n' \
      "$system" "$NAME" "$v" "$asset" "$(sri "$hex")" "$sep"
  done
  printf '  }\n}\n'
}

# Makes this checkout's flake a release of dist/'s binaries, publishing
# nothing: writes nix/release.json for them, stages it (a flake in a git
# checkout sees only what git tracks), and adds each binary to the Nix store
# at the very path fetchurl would fetch it to, so the package is built from
# these files and nothing is downloaded. The path is content-addressed:
# fixed by the name (the asset's) and the hash (release.json's), which
# nix-store --add-fixed computes from the file, so only the file release.json
# names can stand in for the download.
#
# CI's nix job does this with the dist its own run built, so the VM test runs
# the binary the run will release, through the same release.json, fetchurl
# and install as a pinned tag. The release.json it leaves staged must never
# be committed to master (ci.yml's release job says why).
nix_local_release() {
  mkdir -p nix
  release_json > nix/release.json
  git add nix/release.json
  for pair in $NIX_ASSETS; do
    nix-store --add-fixed sha256 "dist/release/${pair#*:}" > /dev/null
  done
  cat nix/release.json
}

# release-json against v1.55.7's real SHA256SUMS: the file flake.nix reads,
# each hash as `nix hash convert --hash-algo sha256 --to sri` gives it
# (worked out with it once and written here, since check runs where there may
# be no nix); and a SHA256SUMS missing a binary, or a version that is not
# one, makes nothing. Run by mise run check.
selftest() {
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  cat > "$work/SHA256SUMS" <<'SUMS'
59dbccc69f4a5dfae5cb26da1e40c9b70a6a3bb45a648a753ef08c3fdb6b0518  tidewaiter-linux-aarch64.tar.gz
814487062ef1e9c347f2f9ede590c543442d87f5e12a1ff56a2e9ca44d76ba3d  tidewaiter-linux-arm64
735506f7813c4c98f6c1dd422a2cf5dd8c90ca31e20c50f3fc56e0975032124c  tidewaiter-linux-armv7
fc6b03a259f3f4b8334e20c541f13ff5924d3f5156543f73a205eec97f538a22  tidewaiter-linux-armv7.tar.gz
24e48cbc722d033358d56ddf8ec74492efce4d2ee6e86d053554dd28a385cc22  tidewaiter-linux-x64
67d518ae5d349067e5d83d87b23c8a6f5f307cd91b0e7ca3b757522cf738440a  tidewaiter-linux-x86_64.tar.gz
e156a0535e56fc827f7f9a36da852abc97419179d8248e1cf5140a70c39c7796  tidewaiter.service
SUMS
  cat > "$work/want.json" <<'JSON'
{
  "version": "1.55.7",
  "assets": {
    "x86_64-linux": {
      "url": "https://github.com/danielbodart/tidewaiter/releases/download/v1.55.7/tidewaiter-linux-x64",
      "hash": "sha256-JOSMvHItAzNY1W3fjsdEku/OTS7m6G0FNVTdKKOFzCI="
    },
    "aarch64-linux": {
      "url": "https://github.com/danielbodart/tidewaiter/releases/download/v1.55.7/tidewaiter-linux-arm64",
      "hash": "sha256-gUSHBi7x6cNH8vnt5ZDFQ0Qth/XhKh/1ai6cpE12uj0="
    },
    "armv7l-linux": {
      "url": "https://github.com/danielbodart/tidewaiter/releases/download/v1.55.7/tidewaiter-linux-armv7",
      "hash": "sha256-c1UG94E8TJj2wd1CKiz13YyQyjHiDFDz/Fbgl1AyEkw="
    }
  }
}
JSON
  (release_json 1.55.7 "$work/SHA256SUMS") > "$work/got.json" || die "release-json refused a release's SHA256SUMS"
  diff -u "$work/want.json" "$work/got.json" || die "release-json: not the release.json flake.nix wants"
  grep -v 'linux-arm64$' "$work/SHA256SUMS" > "$work/short"
  ! (release_json 1.55.7 "$work/short") > /dev/null 2>&1 || die "release-json accepted a SHA256SUMS without linux-arm64"
  ! (release_json v1.55.7 "$work/SHA256SUMS") > /dev/null 2>&1 || die "release-json accepted a version with a v"
  echo "selftest: ok"
}

# The same image CI publishes, for every architecture, from dist/.
image() {
  docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 --build-arg VERSION="$(cat dist/version)" \
    --tag "${1:-danielbodart/$NAME:dev}" .
}

command=${1:-build}
[ $# -gt 0 ] && shift
case $command in
  version|lint|test|check|selftest|e2e|build|dist|smoke|image) "$command" "$@" ;;
  install-check) install_check ;;
  release-due) release_due ;;
  last-release) last_release ;;
  release-json) release_json "$@" ;;
  nix-local-release) nix_local_release ;;
  *)
    echo "Error: '$command' is not a command. Try: version, lint, test, check, selftest, e2e, build, dist, smoke, install-check, release-due, last-release, release-json, nix-local-release, image" >&2
    exit 2
    ;;
esac
