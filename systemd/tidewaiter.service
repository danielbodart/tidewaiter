# Tidewaiter as a native systemd service, for a host without NixOS - the NixOS
# module in nix/module.nix writes the same unit from its options.
#
# Expects the release binary at /usr/local/bin/tidewaiter, conntrack from the
# distribution's conntrack package, and, for the systemd source, Nix installed
# as a multi-user daemon. Configure it with a drop-in (`systemctl edit
# tidewaiter`) rather than by editing this file, so an update can replace it:
#
#   [Service]
#   Environment=TIDEWAITER_INTERVAL=300
#
# To update Docker containers as well, the drop-in also needs the socket's
# group, and the Docker registries on the internet - this unit only lets it
# reach localhost, which is all a unit's health probes need:
#
#   [Unit]
#   After=docker.service
#
#   [Service]
#   Environment=TIDEWAITER_SOURCES=systemd,docker
#   SupplementaryGroups=docker
#   IPAddressAllow=
#   IPAddressDeny=

[Unit]
Description=Tidewaiter, updating services only when they are idle
Documentation=https://github.com/danielbodart/tidewaiter/blob/master/docs/systemd.md
Wants=nix-daemon.socket
After=network.target nix-daemon.socket

[Service]
Environment=TIDEWAITER_SOURCES=systemd
Environment=TIDEWAITER_STATUS_FILE=/run/tidewaiter/status.json
# nix-env and nix-store from the default profile, where a multi-user install
# puts them; conntrack and ss from the distribution.
Environment=PATH=/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Through the daemon, so writing a profile takes no privilege over the store
# itself.
Environment=NIX_REMOTE=daemon
# nix-env wants a home; root's is out of sight (ProtectHome).
Environment=HOME=/var/lib/tidewaiter
ExecStart=/usr/local/bin/tidewaiter run
Restart=on-failure
RestartSec=5
StateDirectory=tidewaiter
# The status file: world-readable, so `tidewaiter status` needs no root.
RuntimeDirectory=tidewaiter

# A pass in flight is finished before Tidewaiter exits, and a swap can take a
# game server's whole stop, its start and two health gates. Killing it halfway
# would leave a profile moved with no gate run. Mixed, so a nix-env it is
# running is not signalled before Tidewaiter has finished with it.
TimeoutStopSec=15min
KillMode=mixed

# Root, because it restarts other services, writes system profiles and reads
# the host's connection table - and otherwise confined as far as that allows.
# Everything it writes is root's, so uid 0 without CAP_DAC_OVERRIDE is enough;
# CAP_NET_ADMIN is for conntrack.
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
# Optional, so a host with no Nix - updating Docker only - still starts.
ReadWritePaths=-/nix/var/nix/profiles
# The closure drop-ins.
ReadWritePaths=/run/systemd/system
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
# Read-only: ss reads cgroupfs to name a socket's cgroup.
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# The drop-ins are for systemd, but an operator should be able to read them too.
UMask=0022
# The bus and the Nix daemon; conntrack and sock_diag; port-connect.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# Units only ever probe localhost. Docker's registries are the internet, so the
# docker source's drop-in clears both.
IPAddressAllow=localhost
IPAddressDeny=any
# Not MemoryDenyWriteExecute: Bun's JIT needs writable code.
# Not PrivateNetwork: conntrack and port-connect are the host's.
# Not PrivateUsers: it must be real root to systemd and the Nix daemon.
# Not ProtectProc: the tcp detector reads /proc/<MainPID>/net.

[Install]
WantedBy=multi-user.target
